<section class="inner-contact-area pt-120 pb-120">
  <div class="container">
    <div class="row align-items-center">
      <div class="col-lg-6">
        <div class="inner-contact-form">
          <h3 class="form-title">Get In Touch</h3>
          <p class="form-desc">
            Have questions?<br />Send us a message and we'll respond as soon as
            possible.
          </p>
          <form
            id="contactForm"
            action="https://api.web3forms.com/submit"
            class="contact-form"
            method="POST"
          >
            <input
              type="hidden"
              name="access_key"
              value="0ece1473-ee7d-4ca6-9b78-a5b35927a523"
            />
            <div class="form-row">
              <div class="form-group half">
                <input
                  name="name"
                  type="text"
                  placeholder="Your Name"
                  required
                />
              </div>
              <div class="form-group half">
                <input
                  name="email"
                  type="email"
                  placeholder="Your Email"
                  required
                />
              </div>
            </div>
            <div class="form-group">
              <input name="subject" type="text" placeholder="Subject" />
            </div>
            <div class="form-group">
              <textarea name="message" placeholder="Your Message" required
              ></textarea>
            </div>
            <div class="form-submit">
              <button type="submit" class="submit-btn">Send Message</button>
            </div>
          </form>
          <div id="contactThankyou" style="display:none;margin-top:15px;">
            <h4 style="margin-bottom:6px;">Thank you!</h4>
            <p>We received your message and will get back to you shortly.</p>
          </div>
          <script>
            document.addEventListener("DOMContentLoaded", function () {
              var form = document.getElementById("contactForm");
              if (!form) return;
              form.addEventListener("submit", async function (e) {
                e.preventDefault();
                var btn = form.querySelector(".submit-btn");
                if (btn) {
                  btn.disabled = true;
                  btn.textContent = "Sending...";
                }
                try {
                  var formData = new FormData(form);
                  await fetch(form.action, {
                    method: "POST",
                    body: formData,
                    headers: { Accept: "application/json" },
                  });
                } catch (err) {
                  /* ignore; still show thank you */
                } finally {
                  if (btn) {
                    btn.disabled = false;
                    btn.textContent = "Send Message";
                  }
                  form.style.display = "none";
                  var ty = document.getElementById("contactThankyou");
                  if (ty) {
                    ty.style.display = "block";
                  }
                }
              });
            });
          </script>
        </div>
      </div>
      <div class="col-lg-6">
        <div class="inner-contact-info">
          <h2 class="title">Our Office Address</h2>
          <div class="contact-info-item">
            <h5 class="title-two">Head Office</h5>
            <ul class="list-wrap">
              <li>
                201, Anand Nagar Complex, 100 Feet Road, Satellite, Ahmedabad,
                Gujarat - 380015
              </li>
              <li>+91 726506 7950</li>
              <li>info.drassociates2024@gmail.com</li>
            </ul>
          </div>
          <!-- <div class="contact-info-item">
                        <h5 class="title-two">Australia Office</h5>
                        <ul class="list-wrap">
                            <li>100 Wilshire Blvd, Suite 700 Santa <br> Monica, CA 90401, USA</li>
                            <li>+1 (310) 620-8565</li>
                            <li>info.drassociates2024@gmail.com</li>
                        </ul>
                    </div> -->
        </div>
      </div>
    </div>
  </div>
</section>
