---
const path = Astro.url.pathname.replace(/\/+$/, "") || "/";

interface NavItem {
  href: string;
  label: string;
  match: (p: string) => boolean;
  children?: { href: string; label: string }[];
}

const nav: NavItem[] = [
  { href: "/", label: "Home", match: (p) => p === "/" },

  {
    href: "/about",
    label: "About Us",
    match: (p) => p.startsWith("/about"),
    children: [
      { href: "/about#about-dr-a", label: "About DR Associates" },
      { href: "/about#vision-mission", label: "Our Vision & Mission" },
      { href: "/about#performance", label: "Our Performance at a Glance" },
      { href: "/about#expertise", label: "Our Expertise" },
      { href: "/about#why-choose", label: "Why Choose DR A?" },
      { href: "/about#team", label: "Team" },
    ],
  },

  { href: "/sse", label: "What is SSE?", match: (p) => p.startsWith("/sse") },

  {
    href: "/services",
    label: "Our Services",
    match: (p) => p.startsWith("/services"),
    children: [
      { href: "/ngo", label: "For NGOs" },
      { href: "/investors", label: "For Investors" },
      { href: "/survey", label: "Survey" },
    ],
  },
  // {
  //   href: "/investors",
  //   label: "Investors Landing",
  //   match: (p) => p.startsWith("/investors"),
  // },

  {
    href: "/blogs",
    label: "Articles",
    match: (p) => p === "/blogs" || /^\/blog-\d+$/i.test(p),
  },
  {
    href: "/contact-us",
    label: "Contact Us",
    match: (p) => p.startsWith("/contact-us"),
  },
];
---

<header id="sticky-header" class="transparent-header header-style-two">
  <div class="container custom-container">
    <div class="heder-top-wrap">
      <div class="row align-items-center">
        <div class="col-lg-7">
          <div class="header-top-left">
            <ul class="list-wrap">
              <li>
                <i class="flaticon-phone-call"></i>Hot Line Number: <a
                  href="tel:+918141155525">+91 8141155525</a
                >
              </li>
            </ul>
          </div>
        </div>
        <div class="col-lg-5">
          <div class="header-top-right">
            <div class="header-social">
              <ul class="list-wrap">
                <li>
                  <a
                    href="https://www.instagram.com/dr_associates?igsh=ZWdoOGRyNTJqdXNl"
                    target="_blank"
                    rel="noopener"><i class="fab fa-instagram"></i></a
                  >
                </li>
                <li>
                  <a
                    href="https://www.linkedin.com/company/d-rassociates/"
                    target="_blank"
                    rel="noopener"><i class="fab fa-linkedin"></i></a
                  >
                </li>
              </ul>
            </div>
            <div class="header-top-btn">
              <a href="/contact-us"
                ><i class="flaticon-briefcase"></i>Free Consulting</a
              >
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="menu-area">
      <div class="row">
        <div class="col-12">
          <div class="mobile-nav-toggler"><i class="fas fa-bars"></i></div>
          <div class="menu-wrap">
            <nav class="menu-nav">
              <div class="logo">
                <a href="/"
                  ><img src="/assets/img/logo/dr_logo_2.png" alt="Logo" /></a
                >
              </div>

              <div style="flex:1 1 0;"></div>

              <div class="navbar-wrap main-menu d-none d-lg-flex">
                <ul class="navigation" style="margin-right:8px;">
                  {
                    nav.map((item) => (
                      <li
                        class={`${
                          item.children ? "menu-item-has-children " : ""
                        }${item.match(path) ? "active" : ""}`}
                      >
                        <a href={item.href}>{item.label}</a>
                        {item.children && (
                          <ul class="sub-menu">
                            {item.children.map((child) => (
                              <li class={child.href === path ? "active" : ""}>
                                <a href={child.href}>{child.label}</a>
                              </li>
                            ))}
                          </ul>
                        )}
                      </li>
                    ))
                  }
                </ul>
                <a
                  href="#"
                  class="menu-tigger"
                  style="margin-left:8px;align-self:center;"
                  ><span></span><span></span><span></span></a
                >
              </div>
            </nav>
          </div>

          <!-- Mobile Menu -->
          <div class="mobile-menu">
            <nav class="menu-box">
              <div class="close-btn"><i class="fas fa-times"></i></div>
              <div class="nav-logo">
                <a href="/"
                  ><img src="/assets/img/logo/dr_logo_2.png" alt="Logo" /></a
                >
              </div>
              <div class="menu-outer"></div>
              <div class="social-links">
                <ul class="clearfix list-wrap">
                  <li>
                    <a
                      href="https://www.instagram.com/dr_associates?igsh=ZWdoOGRyNTJqdXNl"
                      target="_blank"><i class="fab fa-instagram"></i></a
                    >
                  </li>
                  <li>
                    <a
                      href="https://www.linkedin.com/company/d-rassociates/"
                      target="_blank"><i class="fab fa-linkedin"></i></a
                    >
                  </li>
                </ul>
              </div>
            </nav>
          </div>
          <div class="menu-backdrop"></div>
        </div>
      </div>
    </div>
  </div>
</header>
