---
/**
 * BlogCard.astro
 * Props:
 * • title        – blog post title (string, required)
 * • description  – short excerpt (string, required)
 * • date         – display date (string, required, e.g. "22 Jan, 2025")
 * • imageUrl     – thumbnail URL (string, required)
 * • href         – link to full post (string, optional → defaults to "#")
 * • tag          – category / tag label (string, optional)
 * • authorName   – display name (string, optional)
 * • authorAvatar – avatar URL (string, optional)
 */
const {
  title,
  description,
  date,
  imageUrl,
  href        = "#",
  tag         = "",
  authorName  = "Rohit Pandya",
  authorAvatar = "/assets/img/blog/Rohit Pandya.png",
} = Astro.props;
---

<div class="col-lg-3 col-md-4 col-sm-6 mb-5">
  <div class="blog-post-item-two">
    <!-- thumbnail with title overlay -->
    <div class="blog-post-thumb-two">
      <a href={href} class="thumb-link">
        <img src={imageUrl} alt={title} />
        <div class="title-overlay">
          <h2 class="title">{title}</h2>
        </div>
      </a>
    </div>

    <!-- content at bottom -->
    <div class="blog-post-content-two">
      <p>{description}</p>

      <div class="blog-meta">
        <ul class="list-wrap">
          {authorName && (
            <li>
              <a href={href}>
                {authorAvatar && <img src={authorAvatar} alt={authorName} />}
                {authorName}
              </a>
            </li>
          )}
          <li><i class="far fa-calendar"></i>{date}</li>
        </ul>
      </div>
    </div>
  </div>
</div>

<style>
  .blog-post-item-two {
    height: 100%;
    display: flex;
    flex-direction: column;
    background: #fff;
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 4px 6px rgba(0,0,0,0.05);
    transition: transform 0.3s ease;
  }
  .blog-post-item-two:hover {
    transform: translateY(-5px);
  }
  .blog-post-thumb-two {
    position: relative;
    width: 100%;
    height: 220px;
    overflow: hidden;
  }
  .blog-post-thumb-two .thumb-link {
    display: block;
    width: 100%;
    height: 100%;
  }
  .blog-post-thumb-two img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .title-overlay {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    background: rgba(114, 82, 127, 0.92);
    padding: 12px 15px;
    z-index: 2;
  }
  .title-overlay .title {
    color: #fff !important;
    font-size: 17px;
    margin: 0;
    line-height: 1.3;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-weight: 700;
  }
  .blog-post-content-two {
    padding: 15px 15px 20px 15px;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
  }
  .blog-post-content-two p {
    font-size: 14px;
    margin-bottom: 15px;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .blog-meta {
    margin-top: auto;
  }
</style>
