<section
  class="banner-area-eight fix banner-bg-eight"
  style="background-image: url('/assets/img/banner/investor-hero.jpg'); background-size: cover; background-position: center;"
>
  <!-- Note: If you have a specific bg image for investors, replace dr-hero-4.png with it. -->
  <div class="container-fluid p-0">
    <div class="row g-0 justify-content-end">
      <div class="col-xl-6 col-lg-7">
        <div class="banner-content-eight">
          <span class="sub-title pt-60" data-aos="fade-up" data-aos-delay="200">
            DR Associates | Services for Investors
          </span>

          <h1
            class="title"
            style="font-size: 54px; font-weight: 700; color: #fff; margin-bottom: 25px;"
            data-aos="fade-up"
            data-aos-delay="300"
          >
            Turn Your Capital Into <span>Measurable Social Impact</span>
          </h1>

          <p data-aos="fade-up" data-aos-delay="500">
            Invest in SEBI regulated ZCZP instruments on India's Social Stock
            Exchange and back verified NGOs with transparent, audited impact.
          </p>

          <p
            style="color: #ddd; margin-bottom: 40px;"
            data-aos="fade-up"
            data-aos-delay="600"
          >
            DR Associates is a specialist Social Stock Exchange consultant,
            helping impact investors navigate ZCZP instruments, SSE advisory
            services, and high intent impact investing in India.
          </p>

          <div class="banner-btn-seven" data-aos="fade-up" data-aos-delay="700">
            <a
              href="#zczp-opportunities"
              class="btn btn-three border-btn"
              style="margin-right:15px; margin-bottom: 10px;"
              >Explore ZCZP Opportunities</a
            >
            <a
              href="https://wa.me/918141155525"
              class="btn btn-three border-btn"
              style="background:#000; color:#fff;"
              target="_blank">Book Free SSE Consultation</a
            >
          </div>

          <div class="banner-content-shape">
            <img
              src="assets/img/banner/h9_hero_shape01.png"
              alt="shape"
              data-aos="fade-up-right"
              data-aos-delay="800"
            />
            <img
              src="assets/img/banner/h9_hero_shape02.png"
              alt="shape"
              data-aos="fade-down-left"
              data-aos-delay="800"
            />
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
