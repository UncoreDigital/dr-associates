<style>
  @import url("https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@300;400;500;600;700&display=swap");

  .sectors-section {
    padding: 3rem 0;
    background-color: var(--tg-section-background); /* surface-warm */
    font-family: var(--tg-body-font-family);
  }
  @media (min-width: 1024px) {
    .sectors-section {
      padding: 4rem 0;
    }
  }
  .sectors-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1rem;
  }
  @media (min-width: 768px) {
    .sectors-container {
      padding: 0 2rem;
    }
  }
  .sectors-header {
    max-width: 48rem;
    margin: 0 auto 4rem auto;
    text-align: center;
  }
  .sectors-subtitle {
    color: var(--tg-primary-color);
    font-weight: 600;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 0.5rem;
  }
  .sectors-title {
    font-family: var(--tg-heading-font-family);
    color: var(--tg-heading-font-color);
    font-size: 1.875rem;
    line-height: 1.2;
    margin-top: 0.75rem;
    margin-bottom: 1.5rem;
  }
  @media (min-width: 768px) {
    .sectors-title {
      font-size: 2.25rem;
    }
  }
  .sectors-desc {
    color: var(--tg-paragraph-color);
    font-size: 1.125rem;
    line-height: 1.625;
    margin: 0;
  }

  .sectors-grid {
    display: grid;
    gap: 1.5rem;
    max-width: 64rem;
    margin: 0 auto;
    grid-template-columns: 1fr;
  }
  @media (min-width: 640px) {
    .sectors-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 1024px) {
    .sectors-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .sectors-card {
    text-align: center;
    padding: 2rem;
    border-radius: 0.75rem;
    background-color: #ffffff;
    border: 1px solid #e1e4eb;
    transition: all 0.3s ease;
  }
  .sectors-card:hover {
    box-shadow: 0 12px 40px -8px rgba(24, 32, 78, 0.15); /* shadow-elevated */
    transform: translateY(-0.25rem);
  }

  .sectors-icon-wrapper {
    width: 4rem;
    height: 4rem;
    border-radius: 50%;
    background-color: rgba(114, 82, 127, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 1.25rem auto;
    transition: background-color 0.3s ease;
  }
  .sectors-card:hover .sectors-icon-wrapper {
    background-color: rgba(114, 82, 127, 0.2);
  }
  .sectors-icon {
    width: 2rem;
    height: 2rem;
    color: var(--tg-primary-color);
  }

  .sectors-card-title {
    font-family: var(--tg-heading-font-family);
    font-size: 1.25rem;
    color: var(--tg-heading-font-color);
    margin-bottom: 0.75rem;
    margin-top: 0;
  }

  .sectors-card-text {
    color: var(--tg-paragraph-color);
    font-size: 0.875rem;
    line-height: 1.625;
    margin: 0;
  }

  .sectors-footer {
    text-align: center;
    margin-top: 3rem;
  }
  .sectors-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background-color: var(--tg-secondary-color); /* navy */
    color: #ffffff;
    padding: 0.875rem 2rem;
    border-radius: 0.5rem;
    font-weight: 600;
    transition: background-color 0.3s ease;
    text-decoration: none;
  }
  .sectors-btn:hover {
    background-color: #2e386b; /* navy-light */
  }
</style>

<section class="sectors-section">
  <div class="sectors-container">
    <div class="sectors-header">
      <span class="sectors-subtitle">Impact Themes</span>
      <h2 class="sectors-title">Sectors You Can Back</h2>
      <p class="sectors-desc">
        Each ZCZP opportunity includes use of funds, target beneficiaries, key
