            stroke-linejoin="round"
          >
            <path
              d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"
            ></path><path d="M3.22 12H9.5l.5-1 2 4.5 2-7 1.5 3.5h5.27"></path>
          </svg>
        </div>
        <h3 class="sectors-card-title">Healthcare</h3>
        <p class="sectors-card-text">
          Primary care, mobile health units, preventive screenings
        </p>
      </div>

      <!-- Sector 3 -->
      <div class="sectors-card">
        <div class="sectors-icon-wrapper">
          <svg
            class="sectors-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
