      </div>

      <!-- Sector 4 -->
      <div class="sectors-card">
        <div class="sectors-icon-wrapper">
          <svg
            class="sectors-icon"
            xmlns="http://www.w3.org/2000/svg"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path
              d="m13.4 2.09a2 2 0 0 0-2.82 0l-8 8a2 2 0 0 0 0 2.82l8 8a2 2 0 0 0 2.82 0l8-8a2 2 0 0 0 0-2.82z"
            ></path><path d="M12 7v10"></path><path d="m8 11 4-4 4 4"></path>
          </svg>
        </div>
        <h3 class="sectors-card-title">Environment</h3>
        <p class="sectors-card-text">
          Afforestation, water access, climate resilience projects
        </p>
      </div>
    </div>

    <div class="sectors-footer">
      <a href="https://wa.me/918141155525" class="sectors-btn" target="_blank">
        Request Current ZCZP Opportunity Deck
      </a>
    </div>
  </div>
</section>
