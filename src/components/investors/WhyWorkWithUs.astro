<style>
  @import url("https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@300;400;500;600;700&display=swap");

  .why-dr-section {
    padding: 3rem 0;
    background-color: var(--tg-secondary-color); /* navy */
    font-family: var(--tg-body-font-family);
  }
  @media (min-width: 1024px) {
    .why-dr-section {
      padding: 4rem 0;
    }
  }
  .why-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1rem;
  }
  @media (min-width: 768px) {
    .why-container {
      padding: 0 2rem;
    }
  }
  .why-header {
    max-width: 48rem;
    margin: 0 auto 4rem auto;
    text-align: center;
  }
  .why-subtitle {
    color: var(--tg-primary-color); /* gold */
    font-weight: 600;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 0.5rem;
  }
  .why-title {
    font-family: var(--tg-heading-font-family);
    color: #ffffff;
    font-size: 1.875rem;
    line-height: 1.2;
    margin-top: 0.75rem;
    margin-bottom: 1.5rem;
  }
  @media (min-width: 768px) {
    .why-title {
      font-size: 2.25rem;
    }
  }
  .why-desc {
    color: rgba(255, 255, 255, 0.7);
    font-size: 1.125rem;
    line-height: 1.625;
    margin: 0;
  }

  .why-grid {
    display: grid;
    gap: 1.5rem;
    max-width: 56rem;
    margin: 0 auto;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .why-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .why-card {
    display: flex;
    gap: 1.25rem;
    padding: 1.5rem;
    border-radius: 0.75rem;
    background-color: rgba(46, 56, 107, 0.4);
    border: 1px solid rgba(255, 255, 255, 0.1);
    transition:
      background-color 0.3s ease,
      border-color 0.3s ease;
  }
  .why-card:hover {
    border-color: rgba(114, 82, 127, 0.3); /* hover border gold */
  }

  .why-icon-wrapper {
    flex-shrink: 0;
    width: 3rem;
    height: 3rem;
    border-radius: 0.5rem;
    background-color: rgba(114, 82, 127, 0.15); /* gold/15 */
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .why-icon {
    width: 1.5rem;
    height: 1.5rem;
    color: var(--tg-primary-color);
  }

  .why-card-content {
    flex: 1;
  }
  .why-card-title {
    font-size: 1.125rem;
    font-weight: 600;
    color: #ffffff;
    margin-bottom: 0.5rem;
    margin-top: 0;
  }
  .why-card-text {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.875rem;
    line-height: 1.625;
    margin: 0;
  }
</style>

