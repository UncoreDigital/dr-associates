<style>
  @import url("https://fonts.googleapis.com/css2?family=DM+Serif+Display:ital@0;1&family=Inter:wght@300;400;500;600;700&display=swap");

  .receive-section {
    padding: 3rem 0;
    background-color: #ffffff;
    font-family: var(--tg-body-font-family);
  }
  @media (min-width: 1024px) {
    .receive-section {
      padding: 4rem 0;
    }
  }
  .receive-container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 1rem;
  }
  @media (min-width: 768px) {
    .receive-container {
      padding: 0 2rem;
    }
  }

  .receive-grid {
    max-width: 56rem;
    margin: 0 auto;
    display: grid;
    gap: 3rem;
    align-items: center;
    grid-template-columns: 1fr;
  }
  @media (min-width: 768px) {
    .receive-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .receive-content {
  }

  .receive-subtitle {
    color: var(--tg-primary-color);
    font-weight: 600;
    font-size: 0.875rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    display: block;
    margin-bottom: 0.5rem;
  }
  .receive-title {
    font-family: var(--tg-heading-font-family);
    color: var(--tg-heading-font-color);
    font-size: 1.875rem;
    line-height: 1.2;
    margin-top: 0.75rem;
    margin-bottom: 1.5rem;
  }
  @media (min-width: 768px) {
    .receive-title {
      font-size: 2.25rem;
    }
  }
  .receive-desc {
    color: var(--tg-paragraph-color);
    line-height: 1.625;
    margin-bottom: 2rem;
  }

  .receive-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }
  .receive-list-item {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
  }
  .receive-list-icon {
    width: 1.25rem;
    height: 1.25rem;
    color: var(--tg-primary-color);
    flex-shrink: 0;
    margin-top: 0.125rem;
  }
  .receive-list-text {
    color: var(--tg-heading-font-color);
    font-size: 1rem;
  }

  .receive-stats-box {
    background-color: var(--tg-secondary-color); /* navy */
    border-radius: 1rem;
    padding: 2.5rem;
    text-align: center;
  }
  .stats-huge {
    font-family: var(--tg-heading-font-family);
    font-size: 3.75rem;
    color: var(--tg-primary-color);
    line-height: 1;
    margin-bottom: 1rem;
  }
  .stats-desc {
    color: rgba(255, 255, 255, 0.8);
    font-size: 1.125rem;
    margin-bottom: 2rem;
  }

  .stats-divider {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 2rem;
    margin-top: 2rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .stat-item-value {
    font-family: var(--tg-heading-font-family);
    font-size: 1.875rem;
    color: var(--tg-primary-color);
  }
  .stat-item-label {
    color: rgba(255, 255, 255, 0.6);
    font-size: 0.875rem;
    margin-top: 0.25rem;
  }
</style>

<section class="receive-section">
  <div class="receive-container">
    <div class="receive-grid">
      <div class="receive-content">
        <span class="receive-subtitle">Your Investment Experience</span>
        <h2 class="receive-title">
          What You Receive as a DR Associates Investor
        </h2>
        <p class="receive-desc">
          Rather than a simple "invest and wait," DR Associates builds an SSE
          advisory layer around your ZCZP instruments.
        </p>
        <ul class="receive-list">
          <li class="receive-list-item">
            <svg
              class="receive-list-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><path
                d="m9 11 3 3L22 4"></path>
            </svg>
            <span class="receive-list-text"
              >Pre-investment NGO and issue due diligence summary</span
            >
          </li>
          <li class="receive-list-item">
            <svg
              class="receive-list-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><path
                d="m9 11 3 3L22 4"></path>
            </svg>
            <span class="receive-list-text"
              >Clarification of SEBI Social Stock Exchange compliance
              requirements</span
            >
          </li>
          <li class="receive-list-item">
            <svg
              class="receive-list-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><path
                d="m9 11 3 3L22 4"></path>
            </svg>
            <span class="receive-list-text"
              >Review support on key offer documents</span
            >
          </li>
          <li class="receive-list-item">
            <svg
              class="receive-list-icon"
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
            >
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><path
                d="m9 11 3 3L22 4"></path>
            </svg>
            <span class="receive-list-text"
              >Annual Impact Reports and Social Audit reports shared with you</span
            >
          </li>
        </ul>
      </div>

      <div class="receive-stats-box">
        <div class="stats-huge">13+</div>
        <p class="stats-desc">
          NGOs Registered on NSE/BSE SSE Platform through DR Associates
        </p>
        <div class="stats-divider">
          <div>
            <div class="stat-item-value">₹1K</div>
            <p class="stat-item-label">Min. Investment</p>
          </div>
          <div>
            <div class="stat-item-value">4</div>
            <p class="stat-item-label">Investor Categories</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
