<style>
/* Base layout fix */
.tg-element-title {
  white-space: nowrap;
  display: inline-block;
  margin: 0 auto 0 -105px; /* shifts slightly left for desktop */
}

/* Tablet screens */
@media (max-width: 992px) {
  .tg-element-title {
    margin: 0 auto 0 -50px;
  }
}

/* Mobile screens */
@media (max-width: 768px) {
  .tg-element-title {
    margin: 0 auto;
    white-space: normal; /* allows wrapping */
    display: block;
    text-align: center;
    font-size: 1.6rem;
    line-height: 1.3;
  }

  .section-title-two .sub-title {
    font-size: 1rem;
  }

  .testimonial-item-two {
    margin-bottom: 25px;
  }
}
</style>
